# Publieke basis-URL van de site; gebruikt in links in e-mails (bv. https://talentenraad.be)
SITE_URL=
# SMTP-server voor uitgaande mail; leeg in development = mail wordt naar de console gelogd
SMTP_HOST=
# SMTP-poort (standaard 587; 465 gebruikt implicit TLS)
SMTP_PORT=
# SMTP-gebruikersnaam (leeg = geen authenticatie)
SMTP_USER=
# SMTP-wachtwoord
SMTP_PASS=
# Afzender, bv. Talentenraad <noreply@talentenraad.be>
SMTP_FROM=
# Geheime sleutel voor de sessiecookie (minstens 32 tekens), bv. `openssl rand -base64 32`
AUTH_SECRET=
# Komma-gescheiden e-mailadressen die altijd admin zijn (bootstrap), bv. jan@voorbeeld.be,an@voorbeeld.be
ADMIN_EMAILS=
# Databaseverbinding (Postgres); DATABASE_URL is de fallback voor POSTGRES_URL
POSTGRES_URL=
DATABASE_URL=
# Google reCAPTCHA voor het contactformulier (leeg = reCAPTCHA uit)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Alleen voor reCAPTCHA Enterprise
RECAPTCHA_PROJECT_ID=
# Ontvanger van meldingen over nieuwe inzendingen (standaard het adres van de voorzitter)
ADMIN_NOTIFICATION_EMAIL=
# Bearer-token voor /api/cron/cleanup-audit-logs
CRON_SECRET=
