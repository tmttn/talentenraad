{
  "name": "talentenraad",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_OPTIONS='--no-node-snapshot --trace-deprecation' next dev",
    "prebuild": "node scripts/copy-content-assets.mjs",
    "predev": "node scripts/copy-content-assets.mjs",
    "build": "cross-env NODE_OPTIONS='--no-node-snapshot' next build",
    "start": "cross-env NODE_OPTIONS='--no-node-snapshot' next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:a11y": "playwright test accessibility.spec.ts",
    "test:cls": "playwright test layout-shift.spec.ts",
    "prepare": "husky",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
