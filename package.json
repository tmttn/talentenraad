    "drizzle-orm": "^0.45.1",
    "gray-matter": "^4.0.3",
    "image-size": "^2.0.4",
    "jose": "^6.2.14",
    "js-yaml": "^5.5.0",
    "lucide-react": "^1.0.0",
    "next": "16.4.3",
    "nodemailer": "^10.3.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "server-only": "^0.0.1",
    "simple-icons": "^16.2.0",
    "sonner": "^2.0.7",
    "unified": "^11.0.5",
    "zod": "^4.6.7"
